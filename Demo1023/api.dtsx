  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Execute Process Task"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Execute Process Task"
      DTS:DTSID="{6603455E-F233-4637-A9E0-05D997E4967E}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Process Task"
      DTS:TaskContact="Execute Process Task;Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"main.py " + " --modified-since " +  @[User::LastModifiedSince] + " --token " +  @[$Package::apitoken]</DTS:PropertyExpression>
      <DTS:ObjectData>
        <ExecuteProcessData
          Executable="C:\Users\stefa\AppData\Local\Programs\Python\Python312\python.exe"
          Arguments="main.py  --modified-since  --token jsonsrv_284d251d8c9f15122d4450cd97927986697317f7421518fcf76f0ce0ffeabb3e"
          WorkingDirectory="C:\Users\stefa\source\repos\Demo1023"
          StandardOutputVariable="User::ResultData"
          StandardErrorVariable="User::ErrorData" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{21D6BA04-F9CD-4F45-BE78-DD7BAEEE2DB3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7087002A-F7C6-4356-B273-4DC139A900B5}"
          SQLTask:SqlStatementSource="DECLARE @ProcessName NVARCHAR(50) = N'OrdersApi'; &#xA;DECLARE @PreviousLastModified NVARCHAR(100);&#xA;&#xA;-- 1. Hämta det senaste värdet från den tidigare slutförda körningen&#xA;SELECT TOP (1) &#xA;    @PreviousLastModified = [last_modified_since]&#xA;FROM [dbo].[LoadingLog]&#xA;WHERE [name] = @ProcessName&#xA;and last_modified_since &lt;&gt; ''&#xA;ORDER BY [id] DESC;&#xA;&#xA;-- 2. Infoga den nya loggraden med starttid&#xA;INSERT INTO [dbo].[LoadingLog] (&#xA;    [name],&#xA;    [started],&#xA;    [status], [last_modified_since]&#xA;)&#xA;VALUES (&#xA;    @ProcessName,&#xA;    GETUTCDATE(),&#xA;    'IN_PROGRESS', ''&#xA;);&#xA;&#xA;-- 3. Returnera det senaste värdet (eller skicka tillbaka som resultset)&#xA;SELECT ISNULL(@PreviousLastModified, '1900-01-01T00:00:00Z') AS [LastModifiedSince],&#xA;SCOPE_IDENTITY() as Id;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::LastModifiedSince" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::LoadingLogId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D5C1CAE7-52BC-40C9-A859-0333E49543EA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7087002A-F7C6-4356-B273-4DC139A900B5}"
          SQLTask:SqlStatementSource="update [dbo].[LoadingLog]&#xA;set ended=GETUTCDATE(),&#xA;status='DONE',&#xA;last_modified_since=?&#xA;WHERE id=?" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::NextModifiedSince"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::LoadingLogId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Expression Task"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{1669ACC2-1092-44EE-958D-E86E6327C73E}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Expression Task"
      DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::NextModifiedSince] = SUBSTRING(@[User::ResultData], FINDSTRING(@[User::ResultData], &quot;NEXT_MODIFIED_SINCE=&quot;, 1) + 20, 19)" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
