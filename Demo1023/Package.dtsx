    <DTS:Executable
      DTS:refId="Package\merge staging to orders"
      DTS:CreationName="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:Description="Execute T-SQL Statement Task"
      DTS:DTSID="{5B4A4029-C9BB-4D7A-AB06-31C7FE850B2B}"
      DTS:ExecutableType="Microsoft.DbMaintenanceTSQLExecuteTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="merge staging to orders"
      DTS:TaskContact="Execute T-SQL Statement Task; Microsoft Corporation; Microsoft SQL Server v9; © 2004 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DBE2F403-CF42-43E8-948F-D9799F521267}"
          SQLTask:SqlStatementSource="MERGE INTO [FactOrders] AS Target&#xA;USING [FactOrders_Staging] AS Source&#xA;ON (Target.[OrderID] = Source.[OrderID])&#xA;&#xA;-- 1. Om OrderID redan finns: Uppdatera befintliga rader&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        Target.[CustomerID]    = Source.[CustomerID],&#xA;        Target.[OrderDate]     = Source.[OrderDate],&#xA;        Target.[CustomerName]   = Source.[CustomerName],&#xA;        Target.[Amount]         = Source.[Amount],&#xA;        Target.[OrderCategory]  = Source.[OrderCategory],&#xA;        Target.[LoadDate]       = Source.[LoadDate] -- eller GETDATE() om du vill ha tidpunkten för upserten&#xA;&#xA;-- 2. Om OrderID inte finns: Skapa ny rad&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (&#xA;        [OrderID],&#xA;        [CustomerID],&#xA;        [OrderDate],&#xA;        [CustomerName],&#xA;        [Amount],&#xA;        [OrderCategory],&#xA;        [LoadDate]&#xA;    )&#xA;    VALUES (&#xA;        Source.[OrderID],&#xA;        Source.[CustomerID],&#xA;        Source.[OrderDate],&#xA;        Source.[CustomerName],&#xA;        Source.[Amount],&#xA;        Source.[OrderCategory],&#xA;        Source.[LoadDate] -- eller GETDATE()&#xA;    );&#xA;"
          SQLTask:ServerVersion="9"
          SQLTask:ExtendedLogging="True"
          SQLTask:LocalConnectionForLogging=""
          SQLTask:TaskName=""
          SQLTask:IgnoreDatabasesInNotOnlineState="False" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\truncate staging"
