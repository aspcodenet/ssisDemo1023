  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{BDA52FF2-39F0-403C-91E2-F28A83ADA9EC}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="DATEPART(&quot;dw&quot;, GETDATE()) == 1"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="IsCorrectDayToRun">
      <DTS:VariableValue
        DTS:DataType="11">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{39611B1A-1F21-4047-9174-052A634ACB8A}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 4)(YEAR(GETDATE()) + @[$Package::YearsAhead]) + &quot;-12-31&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="StefanEndDatevariabel">
      <DTS:VariableValue
        DTS:DataType="8">2041-12-31</DTS:VariableValue>
    </DTS:Variable>
