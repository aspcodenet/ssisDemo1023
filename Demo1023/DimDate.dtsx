      DTS:DTSID="{D1B87297-0006-4D4A-B355-732494FC3F31}"
      DTS:ObjectName="YearsAhead">
      <DTS:Property
        DTS:DataType="3"
        DTS:Name="ParameterValue">10</DTS:Property>
    </DTS:PackageParameter>
  </DTS:PackageParameters>
  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{4BC0AA05-FFED-4B2E-90E5-1405E84BAFF3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR, 4)(YEAR(GETDATE()) + @[$Package::YearsAhead]) + &quot;-12-31&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="EndDate">
      <DTS:VariableValue
        DTS:DataType="8">2036-12-31</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{486C31D2-D0BE-482F-86DD-9C53D708CC3E}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="DATEPART(&quot;dw&quot;, GETDATE()) == 1"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="IsSunday">
      <DTS:VariableValue
        DTS:DataType="11">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{4009EF65-B294-4A73-B7FB-8BE42DFB18B0}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="StartDate">
      <DTS:VariableValue
        DTS:DataType="8">2020-01-01</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5FE52AA0-8948-4D47-8B73-BAC644E53893}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{048D73F0-C240-413F-A895-BB7159CB0F67}"
          SQLTask:SqlStatementSource="SET DATEFIRST 1;&#xA;&#xA;DECLARE @StartDate DATE = CAST(? AS DATE);&#xA;DECLARE @EndDate   DATE = CAST(? AS DATE);&#xA;&#xA;WITH DatesCTE AS (&#xA;    SELECT @StartDate AS CurrentDate&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, CurrentDate)&#xA;    FROM DatesCTE&#xA;    WHERE CurrentDate &lt; @EndDate&#xA;),&#xA;SourceData AS (&#xA;    SELECT &#xA;        CONVERT(INT, CONVERT(VARCHAR(8), CurrentDate, 112)) AS DateKey,&#xA;        CurrentDate AS FullDate,&#xA;        DATEPART(DAY, CurrentDate) AS DayNumber,&#xA;        -- Svenskt veckodagsnamn med stor begynnelsebokstav:&#xA;        UPPER(LEFT(FORMAT(CurrentDate, 'dddd', 'sv-SE'), 1)) + SUBSTRING(FORMAT(CurrentDate, 'dddd', 'sv-SE'), 2, 20) AS DayName,&#xA;        DATEPART(WEEKDAY, CurrentDate) AS DayOfWeek, -- 1 = Måndag, 7 = Söndag&#xA;        DATEPART(DAYOFYEAR, CurrentDate) AS DayOfYear,&#xA;        DATEPART(ISO_WEEK, CurrentDate) AS WeekOfYear,&#xA;        MONTH(CurrentDate) AS MonthNumber,&#xA;        UPPER(LEFT(FORMAT(CurrentDate, 'MMMM', 'sv-SE'), 1)) + SUBSTRING(FORMAT(CurrentDate, 'MMMM', 'sv-SE'), 2, 20) AS MonthName,&#xA;        DATEPART(QUARTER, CurrentDate) AS QuarterNumber,&#xA;        'Q' + CAST(DATEPART(QUARTER, CurrentDate) AS VARCHAR(1)) AS QuarterName,&#xA;        YEAR(CurrentDate) AS YearNumber,&#xA;        -- Lördag (6) och Söndag (7) räknas som helg:&#xA;        CASE WHEN DATEPART(WEEKDAY, CurrentDate) IN (6, 7) THEN 1 ELSE 0 END AS IsWeekend&#xA;    FROM DatesCTE&#xA;)&#xA;MERGE INTO dbo.DimDate AS Target&#xA;USING SourceData AS Source&#xA;ON Target.DateKey = Source.DateKey&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET &#xA;        Target.FullDate      = Source.FullDate,&#xA;        Target.DayNumber     = Source.DayNumber,&#xA;        Target.DayName       = Source.DayName,&#xA;        Target.DayOfWeek     = Source.DayOfWeek,&#xA;        Target.DayOfYear     = Source.DayOfYear,&#xA;        Target.WeekOfYear    = Source.WeekOfYear,&#xA;        Target.MonthNumber   = Source.MonthNumber,&#xA;        Target.MonthName     = Source.MonthName,&#xA;        Target.QuarterNumber = Source.QuarterNumber,&#xA;        Target.QuarterName   = Source.QuarterName,&#xA;        Target.YearNumber    = Source.YearNumber,&#xA;        Target.IsWeekend     = Source.IsWeekend&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (&#xA;        DateKey, FullDate, DayNumber, DayName, DayOfWeek, &#xA;        DayOfYear, WeekOfYear, MonthNumber, MonthName, &#xA;        QuarterNumber, QuarterName, YearNumber, IsWeekend&#xA;    )&#xA;    VALUES (&#xA;        Source.DateKey, Source.FullDate, Source.DayNumber, Source.DayName, Source.DayOfWeek, &#xA;        Source.DayOfYear, Source.WeekOfYear, Source.MonthNumber, Source.MonthName, &#xA;        Source.QuarterNumber, Source.QuarterName, Source.YearNumber, Source.IsWeekend&#xA;    )&#xA;&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::StartDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::EndDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Expression Task"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{5B772F0E-092C-4C7C-99EA-60EDE7781B5C}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Expression Task"
      DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExpressionTask
          Expression="@[User::IsSunday]" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint]"
      DTS:CreationName=""
      DTS:DTSID="{B7ED731F-D0A8-475C-95B2-009B337FCB70}"
      DTS:EvalOp="1"
      DTS:Expression="@[User::IsSunday]"
      DTS:From="Package\Expression Task"
